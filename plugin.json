{
  "id": "qingting",
  "name": "蜻蜓FM",
  "version": "1.7.0",
  "minAppVersion": "0.1.8",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "webapi.qingting.fm",
      "api2.qingting.fm",
      "audio.qtfm.cn",
      "lhttp-hw.qtfm.cn",
      "*.qtfm.cn",
      "user.qtfm.cn"
    ],
    "process": [
      "ffmpeg",
      "ffmpeg.exe",
      "/opt/homebrew/bin/ffmpeg",
      "/usr/local/bin/ffmpeg",
      "/usr/bin/ffmpeg",
      "/snap/bin/ffmpeg",
      "C:\\ffmpeg\\bin\\ffmpeg.exe",
      "C:\\Program Files\\ffmpeg\\bin\\ffmpeg.exe"
    ]
  },
  "settings": [
    {
      "key": "transcode",
      "label": "转码播放",
      "help": "蜻蜓FM 的音频是 HE-AAC，应用自身解不了，需要本机装好 ffmpeg 并允许本插件运行它。填 0 关闭转码，直接播放原地址（多数内容会报 SBR 错误）。"
    },
    {
      "key": "ffmpegPath",
      "label": "ffmpeg 路径",
      "help": "留空则自动查找（先按 PATH，再试 /opt/homebrew/bin、/usr/local/bin 等常见位置）。找不到时填上完整路径，例如 /opt/homebrew/bin/ffmpeg。",
      "link": "https://ffmpeg.org/download.html"
    }
  ],
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "builtin": "liked"
    },
    {
      "title": "排行榜",
      "page": "rank",
      "icon": "chart"
    },
    {
      "title": "广播",
      "page": "radio",
      "icon": "radio"
    },
    {
      "title": "历史",
      "page": "history",
      "icon": "calendar"
    },
    {
      "builtin": "shows"
    }
  ]
}
